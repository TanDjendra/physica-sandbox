{
  "name": "physics-calculus-sandbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive 3D Math & Physics research sandbox: Torricelli hydrodynamics + calculus optimization",
  "homepage": "https://physica-sandbox-hazel.vercel.app/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify": "esbuild scripts/verify-physics.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify.mjs --log-level=warning && node node_modules/.tmp/verify.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.0",
    "katex": "^0.16.22",
    "leva": "^0.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "three": "^0.176.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
